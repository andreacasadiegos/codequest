# Copy to deploy/.env on the VPS; never commit real values.
APP_ENV=production
APP_TIMEZONE=America/Bogota
POSTGRES_DB=codequest
POSTGRES_USER=codequest
# Generate a long random value and use it in both entries below.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://codequest:REPLACE_WITH_LONG_RANDOM_VALUE@db:5432/codequest
DB_SSLMODE=disable
# Optional CodeBot credentials, if that feature is enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
