# Copy to deploy/.env on the VPS; never commit real values.
APP_ENV=production
APP_TIMEZONE=America/Bogota
# Supabase Session pooler URL used by the existing production database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Optional CodeBot credentials, if that feature is enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
